# zkTanenbaum Testnet — atestiguar conversación (mint CeditRegistros)
SYSCOIN_RPC_URL=https://rpc-zk.tanenbaum.io/
SYSCOIN_CHAIN_ID=57057
SYSCOIN_EXPLORER_URL=https://explorer-zk.tanenbaum.io/
# Contrato ERC-721 (no la wallet deployer/owner)
CEDIT_CONTRACT_ADDRESS=0x4111a92BdA58e53f591e500AaE5f1C6E28e7209E
# Contrato ERC-721 firmas PDF MEF (CeditFirmasPdf) — desplegar: npx hardhat run scripts/deploy-pdf.js --network zktanenbaum
CEDIT_PDF_CONTRACT_ADDRESS=
# Clave de la wallet owner (p. ej. 0x06F907… en explorer) — firma mintRegistro
CEDIT_MINTER_PRIVATE_KEY=0x...
# Gas mint zkTanenbaum (~49 gwei red; 100 = prioridad alta + límite por estimate)
CEDIT_MINT_GAS_GWEI=100
CEDIT_MINT_GAS_BUFFER=1.25
CEDIT_MINT_GAS_FALLBACK=8000000
CEDIT_MINT_GAS_LIMIT_MAX=90000000
# Web: mint desde wallet del usuario (mintRegistroSelf / mintFirmaPdfSelf tras redeploy)
CEDIT_WEB_SELF_MINT=1
